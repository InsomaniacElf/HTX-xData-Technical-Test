FROM python:3.11-slim
WORKDIR /workspace
COPY asr-train/requirements-analysis.txt /tmp/requirements-analysis.txt
RUN pip install --no-cache-dir -r /tmp/requirements-analysis.txt
COPY asr-train /workspace/asr-train
COPY asr /workspace/asr
COPY speaker-detection /workspace/speaker-detection
COPY run_notebooks.py /workspace/run_notebooks.py
CMD ["python", "asr-train/prepare_metadata.py", "--help"]
